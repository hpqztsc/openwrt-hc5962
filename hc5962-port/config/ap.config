#
# AP/bridge-mode package set for HC5962 (profile: ap)
#
# The device keeps 192.168.1.30/24 on br-lan, DHCP/NAT disabled, and
# bridges clients to the upstream 192.168.1.0/24.  WiFi STA uplink is
# bridged with relayd; wired 802.1X is handled by the common overlay.
#

# WiFi STA -> AP bridge
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_luci-proto-relay=y
CONFIG_PACKAGE_travelmate=y
CONFIG_PACKAGE_luci-app-travelmate=y

# multi-uplink (useful if you later switch this profile to NAT/routed mode;
# in pure AP/bridge mode mwan3 is installed but not configured)
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y

# VPN / remote access
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# network services
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

# web console (disabled by default)
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
