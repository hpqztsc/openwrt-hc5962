CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_hiwifi_hc5962=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# LEDE's default LuCI app set uses libustream-openssl; match it.
CONFIG_PACKAGE_luci-ssl-openssl=y
# CONFIG_PACKAGE_libustream-mbedtls is not set
# LEDE's DEFAULT_PACKAGES pulls the full luci collection and default-settings,
# which drags in ssr-plus/upnp/etc.  luci-ssl-openssl already pulls luci-light.
# CONFIG_PACKAGE_luci is not set
# CONFIG_PACKAGE_default-settings is not set

# LEDE's apk support is experimental and defaults to opkg.
# CONFIG_USE_APK is not set
