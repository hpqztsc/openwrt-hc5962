#
# Shared package selection for HiWiFi HC5962 (极路由4 / B70)
#
# Concatenated with config/<source>.config for each build.
#

# ---- base / LuCI ----
# luci-ssl pulls luci-light (base, admin, firewall, IPv6/PPP protocols),
# uhttpd and luci-app-package-manager on all supported trees.
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# ---- wireless: full wpad for AP + STA + wired 802.1X ----
# Full wpad includes hostapd and wpa_supplicant with CONFIG_DRIVER_WIRED,
# EAP-PEAP/TTLS/TLS.  The mt7621 target defaults to wpad-basic-mbedtls, so
# turn that off explicitly.
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpa-cli=y
CONFIG_PACKAGE_hostapd-utils=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_ip-tiny=y

# ---- Wi-Fi drivers / firmware (also selected by the device profile) ----
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt76x2=y

# ---- certificates / diagnostics ----
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_curl=y

# ---- USB / storage (HC5962 has a USB 3.0 port) ----
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
