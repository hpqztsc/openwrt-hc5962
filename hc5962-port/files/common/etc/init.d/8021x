#!/bin/sh /etc/rc.common
#
# Wired 802.1X (EAPOL) supplicant on the HC5962 WAN port.
#
# Starts before netifd so EAPOL is already running when the DHCP client comes
# up.  netifd's udhcpc uses "-t 0", so DHCP keeps retrying until the switch
# authorizes the port.
#
# wpad-openssl (selected in hc5962-port/config/common.config) provides a
# wpa_supplicant built with CONFIG_DRIVER_WIRED and the full EAP/TLS method set.
#

START=19
STOP=89
USE_PROCD=1

CONF=/var/run/8021x-wired.conf
CTRL=/var/run/wpa_supplicant-wired

_wpa_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

_wpa_opt() {
	[ -n "$2" ] && printf '\t%s="%s"\n' "$1" "$(_wpa_escape "$2")"
}

# Args: eap identity password anon phase1 phase2 ca cert key keypass domain
#       altsubject eapol_version
_write_config() {
	local eap="$1" identity="$2" password="$3" anon="$4" phase1="$5" phase2="$6"
	local ca="$7" cert="$8" key="$9"
	shift 9
	local keypass="$1" domain="$2" altsubject="$3" eapol="$4"
	local eap_upper

	eap_upper=$(printf '%s' "$eap" | tr 'a-z' 'A-Z')

	umask 077
	{
		printf 'ctrl_interface=%s\n' "$CTRL"
		printf 'ap_scan=0\n'
		[ -n "$eapol" ] && printf 'eapol_version=%s\n' "$eapol"
		printf 'network={\n'
		printf '\tkey_mgmt=IEEE8021X\n'
		printf '\teap=%s\n' "$eap_upper"
		_wpa_opt identity "$identity"
		_wpa_opt anonymous_identity "$anon"
		_wpa_opt phase1 "$phase1"
		_wpa_opt ca_cert "$ca"
		_wpa_opt client_cert "$cert"
		_wpa_opt private_key "$key"
		_wpa_opt private_key_passwd "$keypass"
		_wpa_opt domain_suffix_match "$domain"
		_wpa_opt altsubject_match "$altsubject"
		case "$eap_upper" in
			TLS)
				;;
			PWD|MD5|LEAP|GTC|OTP)
				_wpa_opt password "$password"
				;;
			*)
				_wpa_opt password "$password"
				[ -z "$phase2" ] && phase2='auth=MSCHAPV2'
				_wpa_opt phase2 "$phase2"
				;;
		esac
		printf '}\n'
	} > "$CONF"
	chmod 600 "$CONF"
	return 0
}

start_service() {
	local enabled device network eap identity password anon phase1 phase2
	local ca cert key keypass domain altsubject eapol eap_upper

	config_load dot1x
	[ -f /etc/config/dot1x ] && chmod 600 /etc/config/dot1x
	config_get_bool enabled wan enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get device wan device wan
	config_get network wan network wan
	config_get eap wan eap peap
	config_get identity wan identity ''
	config_get password wan password ''
	config_get anon wan anonymous_identity ''
	config_get phase1 wan phase1 ''
	config_get phase2 wan phase2 ''
	config_get ca wan ca_cert ''
	config_get cert wan client_cert ''
	config_get key wan private_key ''
	config_get keypass wan private_key_passwd ''
	config_get domain wan domain_suffix_match ''
	config_get altsubject wan altsubject_match ''
	config_get eapol wan eapol_version ''

	eap_upper=$(printf '%s' "$eap" | tr 'a-z' 'A-Z')

	if [ "$eap_upper" = "TLS" ]; then
		if [ -z "$client_cert" ] || [ -z "$private_key" ]; then
			logger -t 8021x "EAP-TLS needs client_cert and private_key"
			return 1
		fi
	elif [ -z "$identity" ] || [ -z "$password" ]; then
		logger -t 8021x "identity/password not configured"
		return 1
	fi

	if ip link show "$device" >/dev/null 2>&1; then
		ip link set dev "$device" up 2>/dev/null || true
	else
		# e.g. a VLAN device created later by netifd; wpa_supplicant will
		# exit and be respawned until the device appears.
		logger -t 8021x "device $device not present yet, will retry"
	fi
	mkdir -p "$CTRL"
	chmod 700 "$CTRL"

	_write_config "$eap" "$identity" "$password" "$anon" \
		"$phase1" "$phase2" "$ca" "$cert" "$key" \
		"$keypass" "$domain" "$altsubject" "$eapol"

	procd_open_instance
	procd_set_param command /usr/sbin/wpa_supplicant \
		-D wired -i "$device" -c "$CONF" -s
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# Renew DHCP once the switch authorizes the port.  This also covers
	# deployments that hand out a guest-VLAN lease before authentication.
	procd_open_instance watch
	procd_set_param command /usr/lib/hc5962/8021x-watch "$device" "$network"
	procd_set_param respawn 3600 10 0
	procd_close_instance
}
