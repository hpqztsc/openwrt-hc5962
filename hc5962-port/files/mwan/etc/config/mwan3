config globals 'globals'
	option mmx_mask '0x3F00'
	option logging '1'
	option tcp_ecn '0'
	option rtmon_interval '5'

config interface 'wan'
	option enabled '1'
	option family 'ipv4'
	option reliability '1'
	# This wired network blocks external ICMP; track the LAN gateway.
	list track_ip '172.20.86.1'

config interface 'wwan'
	option enabled '1'
	option family 'ipv4'
	option reliability '1'
	list track_ip '1.1.1.1'
	list track_ip '223.5.5.5'

config interface 'usbwan'
	option enabled '1'
	option family 'ipv4'
	option reliability '1'
	list track_ip '1.1.1.1'
	list track_ip '223.5.5.5'

config member 'wan_m1'
	option interface 'wan'
	option metric '1'
	option weight '1'

config member 'wwan_m1'
	option interface 'wwan'
	option metric '2'
	option weight '1'

config member 'usbwan_m1'
	option interface 'usbwan'
	option metric '3'
	option weight '1'

config policy 'failover'
	list use_member 'wan_m1'
	list use_member 'wwan_m1'
	list use_member 'usbwan_m1'
	option last_resort 'default'

config rule 'default_rule_v4'
	option dest_ip '0.0.0.0/0'
	option use_policy 'failover'
	option family 'ipv4'
